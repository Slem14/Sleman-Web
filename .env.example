# Welcome Germany — example environment configuration
# Copy to `.env` locally. NEVER commit real values. Secrets live in a secret
# manager in deployed environments (see docs/architecture/adr/0005-hosting-direction.md).

# --- apps/api ---
API_PORT=3001
API_HOST=127.0.0.1
LOG_LEVEL=info

# Exact browser origin allowed by CORS (deny-by-default).
WEB_ORIGIN=http://localhost:3000

# Which analysis provider to use. Only "stub" exists until Stage 4.
ANALYSIS_PROVIDER=stub

# Abuse controls (master-spec §19). Values are not published publicly.
RATE_LIMIT_MAX=10
REQUEST_TIMEOUT_MS=30000

# --- apps/web ---
# Public base URL of the analysis API. Inlined into the client bundle at
# build time, so it must be the URL the BROWSER can reach.
# Left empty in deployed previews: the upload page then shows an honest
# "not switched on yet" state instead of a control that cannot work.
# In `pnpm dev` this defaults to http://127.0.0.1:3001 automatically.
NEXT_PUBLIC_API_BASE_URL=

# No AI provider credentials exist yet by design (Stage 4).
# When they do, they will be listed here as names only, values always empty.
